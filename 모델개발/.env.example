# Copy to .env locally and fill only keys you have. Never commit .env.
# Public archived inventory experiments do not require any key.
SEOUL_API_KEY=
KOPIS_API_KEY=
KMA_API_KEY=
DATA_GO_KR_API_KEY=

# CycleOn server-side integration. Use a random service token of at least 32 characters.
# The browser must never receive the service token or any provider key.
CYCLEON_SERVICE_TOKEN=
CYCLEON_AI_BASE_URL=
CYCLEON_RUNTIME_DIR=
# Separate local synthetic API token. The mock runner does not read .env.
CYCLEON_MOCK_TOKEN=
# Keys used by the new collector; distinct from the legacy demo names above.
SEOUL_COLLECTION_API_KEY=
DATA_GO_KR_SERVICE_KEY=
KMA_APIHUB_AUTH_KEY=
