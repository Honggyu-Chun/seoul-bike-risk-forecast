{
  "openapi": "3.1.0",
  "info": {
    "title": "CycleOn AI service",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/status": {
      "get": {
        "summary": "Status",
        "operationId": "status_v1_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/predictions": {
      "post": {
        "summary": "Predictions",
        "operationId": "predictions_v1_predictions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PredictionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/recommendations": {
      "post": {
        "summary": "Recommendations",
        "operationId": "recommendations_v1_recommendations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecommendationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Prediction": {
        "properties": {
          "station_id": {
            "type": "string",
            "title": "Station Id"
          },
          "horizon_hours": {
            "type": "integer",
            "enum": [
              1,
              2,
              3
            ],
            "title": "Horizon Hours"
          },
          "target_at": {
            "type": "string",
            "format": "date-time",
            "title": "Target At"
          },
          "risk_probability": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Risk Probability"
          },
          "is_risk": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Is Risk"
          },
          "model_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Id"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "input_group": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "T",
                  "S",
                  "W",
                  "F",
                  "E",
                  "C"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Input Group"
          },
          "latest_inventory": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest Inventory"
          },
          "latest_inventory_received_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest Inventory Received At"
          },
          "latest_inventory_age_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest Inventory Age Seconds"
          },
          "latest_inventory_observed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest Inventory Observed At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "station_id",
          "horizon_hours",
          "target_at"
        ],
        "title": "Prediction"
      },
      "PredictionRequest": {
        "properties": {
          "station_ids": {
            "items": {
              "type": "string",
              "maxLength": 80,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 500,
            "minItems": 1,
            "title": "Station Ids"
          },
          "horizons_hours": {
            "items": {
              "type": "integer",
              "enum": [
                1,
                2,
                3
              ]
            },
            "type": "array",
            "maxItems": 3,
            "minItems": 1,
            "title": "Horizons Hours"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "station_ids"
        ],
        "title": "PredictionRequest"
      },
      "PredictionResponse": {
        "properties": {
          "base_at": {
            "type": "string",
            "format": "date-time",
            "title": "Base At"
          },
          "requested_at": {
            "type": "string",
            "format": "date-time",
            "title": "Requested At"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/Prediction"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "base_at",
          "requested_at",
          "items"
        ],
        "title": "PredictionResponse"
      },
      "RankedPrediction": {
        "properties": {
          "station_id": {
            "type": "string",
            "title": "Station Id"
          },
          "horizon_hours": {
            "type": "integer",
            "enum": [
              1,
              2,
              3
            ],
            "title": "Horizon Hours"
          },
          "target_at": {
            "type": "string",
            "format": "date-time",
            "title": "Target At"
          },
          "risk_probability": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Risk Probability"
          },
          "is_risk": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Is Risk"
          },
          "model_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Id"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "input_group": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "T",
                  "S",
                  "W",
                  "F",
                  "E",
                  "C"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Input Group"
          },
          "latest_inventory": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest Inventory"
          },
          "latest_inventory_received_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest Inventory Received At"
          },
          "latest_inventory_age_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest Inventory Age Seconds"
          },
          "latest_inventory_observed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest Inventory Observed At"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "latitude": {
            "type": "number",
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "title": "Longitude"
          },
          "distance_m": {
            "type": "number",
            "minimum": 0.0,
            "title": "Distance M"
          },
          "score": {
            "type": "number",
            "title": "Score"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "station_id",
          "horizon_hours",
          "target_at",
          "name",
          "latitude",
          "longitude",
          "distance_m",
          "score"
        ],
        "title": "RankedPrediction"
      },
      "RecommendationRequest": {
        "properties": {
          "latitude": {
            "type": "number",
            "maximum": 39.0,
            "minimum": 33.0,
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "maximum": 132.0,
            "minimum": 124.0,
            "title": "Longitude"
          },
          "horizon_hours": {
            "type": "integer",
            "enum": [
              1,
              2,
              3
            ],
            "title": "Horizon Hours"
          },
          "radius_m": {
            "type": "number",
            "maximum": 1500.0,
            "exclusiveMinimum": 0.0,
            "title": "Radius M",
            "default": 500
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "latitude",
          "longitude",
          "horizon_hours"
        ],
        "title": "RecommendationRequest"
      },
      "RecommendationResponse": {
        "properties": {
          "base_at": {
            "type": "string",
            "format": "date-time",
            "title": "Base At"
          },
          "requested_at": {
            "type": "string",
            "format": "date-time",
            "title": "Requested At"
          },
          "horizon_hours": {
            "type": "integer",
            "enum": [
              1,
              2,
              3
            ],
            "title": "Horizon Hours"
          },
          "radius_m": {
            "type": "number",
            "title": "Radius M"
          },
          "distance_type": {
            "type": "string",
            "const": "straight_line",
            "title": "Distance Type"
          },
          "automatic_radius_expansion": {
            "type": "boolean",
            "const": false,
            "title": "Automatic Radius Expansion"
          },
          "recommended": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RankedPrediction"
              },
              {
                "type": "null"
              }
            ]
          },
          "alternatives": {
            "items": {
              "$ref": "#/components/schemas/RankedPrediction"
            },
            "type": "array",
            "maxItems": 2,
            "title": "Alternatives"
          },
          "abstained": {
            "type": "boolean",
            "title": "Abstained"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "no_station_within_radius",
                  "recommendation_policy_not_selected",
                  "no_fresh_positive_eligible_prediction"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "nearby_count": {
            "type": "integer",
            "title": "Nearby Count"
          },
          "eligible_count": {
            "type": "integer",
            "title": "Eligible Count"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "base_at",
          "requested_at",
          "horizon_hours",
          "radius_m",
          "distance_type",
          "automatic_radius_expansion",
          "recommended",
          "alternatives",
          "abstained",
          "reason",
          "nearby_count",
          "eligible_count"
        ],
        "title": "RecommendationResponse"
      },
      "StatusResponse": {
        "properties": {
          "service": {
            "type": "string",
            "const": "CycleOn",
            "title": "Service"
          },
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status"
          },
          "server_at": {
            "type": "string",
            "format": "date-time",
            "title": "Server At"
          },
          "base_at": {
            "type": "string",
            "format": "date-time",
            "title": "Base At"
          },
          "supported_targets": {
            "items": {
              "type": "string",
              "format": "date-time"
            },
            "type": "array",
            "title": "Supported Targets"
          },
          "model_bundle_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Bundle Id"
          },
          "model_stage": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Stage"
          },
          "last_precompute_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Precompute At"
          },
          "precompute_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Precompute Error"
          },
          "data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Data"
          },
          "latest_inventory_age_limit_seconds": {
            "type": "integer",
            "title": "Latest Inventory Age Limit Seconds"
          },
          "time_policy": {
            "type": "string",
            "title": "Time Policy"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "service",
          "status",
          "server_at",
          "base_at",
          "supported_targets",
          "model_bundle_id",
          "model_stage",
          "last_precompute_at",
          "precompute_error",
          "data",
          "latest_inventory_age_limit_seconds",
          "time_policy"
        ],
        "title": "StatusResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
