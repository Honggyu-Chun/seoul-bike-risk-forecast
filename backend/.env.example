# 복사해서 backend/.env로 사용. .env는 커밋하지 않는다.

# AI 서비스 (개발: 모델개발 목업 18011)
CYCLEON_AI_BASE_URL=http://127.0.0.1:18011
# 32자 이상. AI 서비스와 같은 값
CYCLEON_SERVICE_TOKEN=
CYCLEON_AI_TIMEOUT_SECONDS=5
# AI 응답의 기준 정각이 백엔드와 같은지 확인. 목업은 시계가 2026-10-29 14:40 KST로 고정이라 false로 둔다
CYCLEON_AI_CLOCK_CHECK=false

# 브라우저 호출을 허용할 프론트 주소 (JSON 배열). 로그인·회원 API의 Origin 확인도 이 목록을 쓴다
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# 세션 쿠키 Secure 속성. https 운영은 true, http 로컬 개발은 false
CYCLEON_COOKIE_SECURE=false
# bcrypt 비용 (기본 12). 낮추지 않는다
CYCLEON_BCRYPT_ROUNDS=12
# ?debug=true 허용 여부. 운영에서는 false
CYCLEON_DEBUG_ENABLED=true

# DB (docker compose up -d로 띄운 개발 DB)
DATABASE_URL=postgresql+asyncpg://cycleon:cycleon-local@127.0.0.1:5432/cycleon
# pytest가 쓰는 DB. 비워 두면 DB 테스트는 건너뜀. 테스트가 데이터를 지우므로 개발 DB와 다른 DB를 쓴다
TEST_DATABASE_URL=postgresql+asyncpg://cycleon:cycleon-local@127.0.0.1:5432/cycleon_test
# 따릉이 수집기 (python -m app.collectors.seoul_bike). 키는 data.seoul.go.kr에서 발급
SEOUL_COLLECTION_API_KEY=
# 수집 간격(초). 추천에 필요한 재고 신선도가 300초라 120초 권장
CYCLEON_COLLECTION_INTERVAL_SECONDS=120
# 재고 보관 시간. AI 첫 동기화(170시간)보다 길어야 함
CYCLEON_RETENTION_HOURS=192
